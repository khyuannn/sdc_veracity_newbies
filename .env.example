# Variable names only. Never commit real values; on Replit use Secrets.

# API server (artifacts/api-server)
# PORT=8080
# Exact browser origin(s) trusted for POST requests, comma-separated, no trailing slash.
# APP_ORIGIN=http://localhost:5173
# Replit App Storage directory for case evidence uploads (uploads fail without it).
# PRIVATE_OBJECT_DIR=
# LOG_LEVEL=info

# Optional: run "Count from photo" on RunPod Serverless (GUIDE.md, "Count from photo").
# Without both, the API's built-in counter is used. On Replit use Secrets.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# Python backend (artifacts/api-server/backend)
# VERACITY_DB=/absolute/path/to/veracity.sqlite3
# VERACITY_DEMO_MODE=true

# Local run without Replit (pnpm local); set in the terminal, see GUIDE.md
# LOCAL_WEB_PORT=3000
# LOCAL_API_PORT=8000
# LOCAL_VITE_PORT=5173
# LOCAL_DATA_DIR=.veracity-local
# PYTHON_EXECUTABLE=python
